rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasVerifiedSuperAdminClaim() {
      return signedIn()
        && request.auth.token.superAdmin == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin';
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveInstituteAdmin() {
      return signedIn()
        && callerProfile().active == true
        && callerProfile().role == 'instituteAdmin'
        && callerProfile().instituteId is string
        && get(/databases/$(database)/documents/institutes/$(callerProfile().instituteId)).data.active == true
        && get(/databases/$(database)/documents/institutes/$(callerProfile().instituteId)).data.status == 'active';
    }

    function isActiveTeacher() {
      return signedIn()
        && callerProfile().active == true
        && callerProfile().role == 'teacher'
        && callerProfile().instituteId is string
        && get(/databases/$(database)/documents/institutes/$(callerProfile().instituteId)).data.active == true
        && get(/databases/$(database)/documents/institutes/$(callerProfile().instituteId)).data.status == 'active';
    }

    function isActiveParent() {
      return signedIn()
        && callerProfile().active == true
        && callerProfile().role == 'parent';
    }

    function hasActiveParentLink(studentId, instituteId) {
      return isActiveParent()
        && exists(/databases/$(database)/documents/parent_student_links/$(request.auth.uid + '_' + studentId))
        && get(/databases/$(database)/documents/parent_student_links/$(request.auth.uid + '_' + studentId)).data.active == true
        && get(/databases/$(database)/documents/parent_student_links/$(request.auth.uid + '_' + studentId)).data.instituteId == instituteId;
    }

    function parentScope() {
      return get(/databases/$(database)/documents/parent_access_scopes/$(request.auth.uid)).data;
    }

    function activeParentScope() {
      return isActiveParent()
        && exists(/databases/$(database)/documents/parent_access_scopes/$(request.auth.uid))
        && parentScope().active == true;
    }

    function instituteIsActive(instituteId) {
      return get(/databases/$(database)/documents/institutes/$(instituteId)).data.active == true
        && get(/databases/$(database)/documents/institutes/$(instituteId)).data.status == 'active';
    }

    function parentCanReadStudent(studentId, instituteId) {
      return activeParentScope()
        && studentId in parentScope().studentIds
        && instituteId in parentScope().instituteIds
        && hasActiveParentLink(studentId, instituteId)
        && instituteIsActive(instituteId);
    }

    function parentCanReadClass(classId, instituteId) {
      return activeParentScope()
        && classId in parentScope().classIds
        && instituteId in parentScope().instituteIds
        && instituteIsActive(instituteId);
    }

    function parentCanReadInstitute(instituteId) {
      return activeParentScope()
        && instituteId in parentScope().instituteIds
        && instituteIsActive(instituteId);
    }

    function parentCanReadNotice(data) {
      return parentCanReadInstitute(data.instituteId)
        && data.active == true
        && data.publishedAt <= request.time
        && (data.expiresAt == null || data.expiresAt > request.time)
        && (
          data.targetType == 'instituteParents'
          || (data.targetType == 'student'
            && data.targetStudentIds.hasAny(parentScope().studentIds))
          || (data.targetType == 'class'
            && data.targetClassIds.hasAny(parentScope().classIds))
        );
    }

    function teacherPermission(permission) {
      return isActiveTeacher()
        && callerProfile().permissions[permission] == true;
    }

    function mayManageInstitute(instituteId) {
      return hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin() && callerProfile().instituteId == instituteId);
    }

    function mayCreateClass(instituteId) {
      return mayManageInstitute(instituteId)
        || (teacherPermission('canCreateClasses')
          && callerProfile().instituteId == instituteId);
    }

    function mayEditClass(data) {
      return mayManageInstitute(data.instituteId)
        || (teacherPermission('canEditClasses')
          && callerProfile().instituteId == data.instituteId
          && request.auth.uid in data.teacherIds);
    }

    function validTeacherClassCreate(data) {
      return teacherPermission('canCreateClasses')
        && callerProfile().instituteId == data.instituteId
        && data.teacherIds.size() == 1
        && data.teacherIds[0] == request.auth.uid
        && data.primaryTeacherId == request.auth.uid
        && data.createdBy == request.auth.uid
        && data.updatedBy == request.auth.uid;
    }

    function validTeacherClassUpdate() {
      return teacherPermission('canEditClasses')
        && resource.data.status != 'archived'
        && callerProfile().instituteId == resource.data.instituteId
        && request.auth.uid in resource.data.teacherIds
        && request.resource.data.teacherIds == resource.data.teacherIds
        && request.resource.data.primaryTeacherId == resource.data.primaryTeacherId
        && request.resource.data.status == resource.data.status
        && request.resource.data.active == resource.data.active;
    }

    function mayManageScheduleChange(classId, instituteId) {
      return mayManageInstitute(instituteId)
        || (teacherPermission('canEditClasses')
          && callerProfile().instituteId == instituteId
          && get(/databases/$(database)/documents/classes/$(classId)).data.status != 'archived'
          && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds);
    }

    function isAssignedTeacher(classId) {
      return isActiveTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.instituteId == callerProfile().instituteId
        && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds;
    }

    function mayInstituteAdminRead(target) {
      return isActiveInstituteAdmin()
        && target.instituteId == callerProfile().instituteId
        && target.role in ['instituteAdmin', 'teacher'];
    }

    function safeSelfUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['displayName', 'lastLoginAt', 'updatedAt', 'updatedBy', 'mustChangePassword', 'status'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.instituteId == resource.data.instituteId
        && request.resource.data.active == resource.data.active
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.active == resource.data.active
        && (
          request.resource.data.mustChangePassword == resource.data.mustChangePassword
          || (resource.data.mustChangePassword == true && request.resource.data.mustChangePassword == false)
        )
        && (
          request.resource.data.role != 'teacher'
          || request.resource.data.status == resource.data.status
          || (
            resource.data.status == 'pendingFirstLogin'
            && request.resource.data.status == 'active'
            && resource.data.mustChangePassword == true
            && request.resource.data.mustChangePassword == false
            && request.resource.data.updatedBy == request.auth.uid
          )
        )
        && (
          request.resource.data.role != 'teacher'
          || (
            request.resource.data.permissions == resource.data.permissions
            && request.resource.data.employeeNumber == resource.data.employeeNumber
          )
        );
    }

    function validTeacherPermissions(data) {
      return data is map
        && data.keys().hasOnly([
          'canCreateClasses', 'canEditClasses', 'canAddStudents',
          'canEditStudents', 'canGenerateQrCodes', 'canTakeAttendance',
          'canCorrectAttendance', 'canExportReports',
          'canViewParentContacts', 'canSendManualNotifications'
        ])
        && data.keys().hasAll([
          'canCreateClasses', 'canEditClasses', 'canAddStudents',
          'canEditStudents', 'canGenerateQrCodes', 'canTakeAttendance',
          'canCorrectAttendance', 'canExportReports',
          'canViewParentContacts', 'canSendManualNotifications'
        ])
        && data.canCreateClasses is bool
        && data.canEditClasses is bool
        && data.canAddStudents is bool
        && data.canEditStudents is bool
        && data.canGenerateQrCodes is bool
        && data.canTakeAttendance is bool
        && data.canCorrectAttendance is bool
        && data.canExportReports is bool
        && data.canViewParentContacts is bool
        && data.canSendManualNotifications is bool;
    }

    function validTeacher(data, uid) {
      return data.uid == uid
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 160
        && data.role == 'teacher'
        && data.instituteId is string
        && data.active is bool
        && data.mustChangePassword is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdBy is string && data.updatedBy is string
        && (data.phoneNumber == null || data.phoneNumber is string)
        && (data.employeeNumber == null || (data.employeeNumber is string && data.employeeNumber.matches('^[A-Z0-9][A-Z0-9_-]{1,31}$')))
        && validTeacherPermissions(data.permissions)
        && data.status in ['active', 'disabled', 'pendingFirstLogin']
        && (
          (data.active == false && data.status == 'disabled')
          || (data.active == true && data.mustChangePassword == true && data.status == 'pendingFirstLogin')
          || (data.active == true && data.mustChangePassword == false && data.status == 'active')
        );
    }

    function mayManageTeacher(target) {
      return hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin()
          && target.instituteId == callerProfile().instituteId);
    }

    function validTeacherManagementUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.role == 'teacher'
        && request.resource.data.role == 'teacher'
        && mayManageTeacher(resource.data)
        && validTeacher(request.resource.data, uid)
        && changed.hasOnly([
          'displayName', 'phoneNumber', 'employeeNumber', 'permissions',
          'active', 'status', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.email == resource.data.email
        && request.resource.data.instituteId == resource.data.instituteId
        && request.resource.data.mustChangePassword == resource.data.mustChangePassword
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.lastLoginAt == resource.data.lastLoginAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && get(/databases/$(database)/documents/institutes/$(resource.data.instituteId)).data.active == true
        && get(/databases/$(database)/documents/institutes/$(resource.data.instituteId)).data.status == 'active'
        && (
          request.resource.data.employeeNumber == null
          || (
            existsAfter(/databases/$(database)/documents/teacher_employee_numbers/$(resource.data.instituteId + '_' + request.resource.data.employeeNumber))
            && getAfter(/databases/$(database)/documents/teacher_employee_numbers/$(resource.data.instituteId + '_' + request.resource.data.employeeNumber)).data.teacherUid == uid
          )
        );
    }

    function validInstituteCode(code) {
      return code is string
        && code.size() >= 3
        && code.size() <= 16
        && code.matches('^[A-Z][A-Z0-9_-]{2,15}$');
    }

    function validInstitute(data, id) {
      return data.keys().hasOnly([
          'instituteId', 'instituteCode', 'name', 'address', 'contactNumber',
          'email', 'active', 'status', 'pushNotificationsEnabled', 'smsEnabled',
          'smsMonthlyLimit', 'allowPaidExtraSms', 'smsUsedThisMonth', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.instituteId == id
        && validInstituteCode(data.instituteCode)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.address is string && data.address.size() <= 500
        && data.contactNumber is string && data.contactNumber.size() >= 7 && data.contactNumber.size() <= 24
        && data.email is string && data.email.size() <= 254
        && data.active is bool
        && data.status in ['active', 'suspended', 'inactive']
        && data.active == (data.status == 'active')
        && data.pushNotificationsEnabled is bool
        && data.smsEnabled is bool
        && data.smsMonthlyLimit is int && data.smsMonthlyLimit >= 0
        && data.allowPaidExtraSms is bool
        && data.smsUsedThisMonth is int && data.smsUsedThisMonth >= 0
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdBy is string && data.updatedBy is string;
    }

    function validAudit(data, id) {
      return data.keys().hasOnly([
          'auditLogId', 'actorUid', 'actorRole', 'instituteId', 'action',
          'targetType', 'targetId', 'summary', 'createdAt'
        ])
        && data.auditLogId == id
        && data.actorUid == request.auth.uid
        && data.actorRole in ['superAdmin', 'instituteAdmin', 'teacher']
        && (data.instituteId == null || data.instituteId is string)
        && data.action in [
          'instituteCreated', 'instituteUpdated', 'instituteSuspended',
          'instituteActivated', 'instituteAdminCreated',
          'instituteAdminDisabled', 'smsSettingChanged', 'pushSettingChanged',
          'passwordResetRequested', 'teacherCreated', 'teacherUpdated',
          'teacherDisabled', 'teacherReactivated',
          'teacherPermissionsChanged', 'teacherPasswordResetRequested',
          'teacherFirstLoginCompleted', 'classCreated', 'classUpdated',
          'classActivated', 'classDeactivated', 'classArchived',
          'classTeacherAssigned', 'classTeacherRemoved', 'classScheduleChanged',
          'classScheduleChangeCancelled', 'studentCreated', 'studentUpdated',
          'studentActivated', 'studentDeactivated', 'studentSuspended',
          'studentMarkedLeft', 'studentAssignedToClass', 'studentRemovedFromClass',
          'studentScheduleOverlapConfirmed', 'studentNumberChanged',
          'classCodeChanged', 'studentQrRegenerated', 'studentQrDisabled',
          'studentQrEnabled', 'attendanceSessionStarted',
          'attendanceSessionClosed', 'attendanceSessionCancelled',
          'studentEntryRecorded', 'studentDepartureRecorded',
          'manualAttendanceRecorded', 'attendanceCorrected',
          'duplicateScanRejected', 'invalidQrRejected', 'qrRegenerated',
          'qrDisabled', 'qrEnabled', 'attendanceReportExported'
        ]
        && data.targetType in ['institute', 'user', 'teacher', 'smsSettings', 'pushSettings',
          'academicClass', 'student', 'classStudentAssignment', 'scheduleChange',
          'qrToken', 'attendanceSession', 'attendanceRecord', 'attendanceReport']
        && data.targetId is string
        && data.summary is string && data.summary.size() > 0 && data.summary.size() <= 300
        && data.createdAt == request.time;
    }

    function validSuperAdminAudit(data) {
      return data.actorRole == 'superAdmin'
        && (
          data.action != 'passwordResetRequested'
          || (
            data.targetType == 'user'
            && data.summary == 'Password reset email requested for authorized account'
            && get(/databases/$(database)/documents/users/$(data.targetId)).data.role == 'instituteAdmin'
            && get(/databases/$(database)/documents/users/$(data.targetId)).data.instituteId == data.instituteId
          )
        );
    }

    function isTeacherAuditAction(action) {
      return action in [
        'teacherCreated', 'teacherUpdated', 'teacherDisabled',
        'teacherReactivated', 'teacherPermissionsChanged',
        'teacherPasswordResetRequested'
      ];
    }

    function validTeacherManagementAudit(data) {
      return isTeacherAuditAction(data.action)
        && data.targetType == 'teacher'
        && getAfter(/databases/$(database)/documents/users/$(data.targetId)).data.role == 'teacher'
        && getAfter(/databases/$(database)/documents/users/$(data.targetId)).data.instituteId == data.instituteId
        && (
          (hasVerifiedSuperAdminClaim() && data.actorRole == 'superAdmin')
          || (
            isActiveInstituteAdmin()
            && data.actorRole == 'instituteAdmin'
            && data.instituteId == callerProfile().instituteId
          )
        );
    }

    function validTeacherFirstLoginAudit(data) {
      return data.actorRole == 'teacher'
        && data.action == 'teacherFirstLoginCompleted'
        && data.targetType == 'teacher'
        && data.targetId == request.auth.uid
        && data.instituteId == callerProfile().instituteId
        && data.summary == 'Teacher completed required first-login password change';
    }

    function isTrustedAttendanceAudit(action) {
      return action in [
        'studentQrRegenerated', 'studentQrDisabled', 'studentQrEnabled',
        'attendanceSessionStarted', 'attendanceSessionClosed',
        'attendanceSessionCancelled', 'studentEntryRecorded',
        'studentDepartureRecorded', 'manualAttendanceRecorded',
        'attendanceCorrected', 'duplicateScanRejected', 'invalidQrRejected',
        'qrRegenerated', 'qrDisabled', 'qrEnabled', 'attendanceReportExported'
      ];
    }

    function validInstituteAdminPasswordResetAudit(data) {
      return isActiveInstituteAdmin()
        && data.actorRole == 'instituteAdmin'
        && data.action == 'teacherPasswordResetRequested'
        && data.targetType == 'teacher'
        && data.instituteId == callerProfile().instituteId
        && data.summary == 'Password reset email requested for authorized account'
        && get(/databases/$(database)/documents/users/$(data.targetId)).data.role == 'teacher'
        && get(/databases/$(database)/documents/users/$(data.targetId)).data.instituteId == callerProfile().instituteId;
    }

    function validSmsSettings(data, instituteId) {
      return data.keys().hasOnly([
          'instituteId', 'smsEnabled', 'smsMonthlyLimit',
          'allowPaidExtraSms', 'updatedAt', 'updatedBy'
        ])
        && data.instituteId == instituteId
        && data.smsEnabled is bool
        && data.smsMonthlyLimit is int && data.smsMonthlyLimit >= 0
        && data.allowPaidExtraSms is bool
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    // Consent is intentionally minimal: no phone number, parent contact, or
    // message content is stored here. A Worker verifies it before requesting
    // any provider delivery.
    function validStudentSmsConsent(data, studentId) {
      return data.keys().hasOnly(['studentId', 'instituteId', 'granted', 'updatedAt'])
        && data.studentId == studentId
        && data.instituteId is string
        && data.granted is bool
        && data.updatedAt == request.time;
    }

    function validClassCode(code) {
      return code is string && code.size() >= 2 && code.size() <= 32
        && code.matches('^[A-Z0-9][A-Z0-9_-]{1,31}$');
    }

    function validClass(data, classId) {
      return data.keys().hasOnly([
          'classId', 'instituteId', 'classCode', 'name', 'subject', 'grade', 'description',
          'primaryTeacherId', 'teacherIds', 'daysOfWeek', 'startTime', 'endTime',
          'roomOrLocation', 'academicYear', 'active', 'status', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.classId == classId
        && data.instituteId is string
        && validClassCode(data.classCode)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 120
        && (data.grade == null || data.grade is string)
        && data.description is string && data.description.size() <= 1000
        && data.teacherIds is list && data.teacherIds.size() <= 1
        && ((data.teacherIds.size() == 0 && data.primaryTeacherId == null)
          || (data.teacherIds.size() == 1 && data.primaryTeacherId is string
            && data.teacherIds[0] == data.primaryTeacherId))
        && data.daysOfWeek is list && data.daysOfWeek.size() > 0
        && data.daysOfWeek.toSet().hasOnly(['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'])
        && data.startTime is string && data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.endTime is string && data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.roomOrLocation is string && data.roomOrLocation.size() <= 160
        && data.academicYear is int && data.academicYear >= 2000 && data.academicYear <= 2200
        && data.active is bool && data.status in ['active', 'inactive', 'archived']
        && data.active == (data.status == 'active')
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt is timestamp && data.updatedBy is string
        && (data.primaryTeacherId == null || (
          get(/databases/$(database)/documents/users/$(data.primaryTeacherId)).data.role == 'teacher'
          && get(/databases/$(database)/documents/users/$(data.primaryTeacherId)).data.instituteId == data.instituteId
        ));
    }

    function validStudentNumber(value) {
      return value is string && value.size() >= 2 && value.size() <= 40
        && value.matches('^[A-Z0-9][A-Z0-9_-]{1,39}$');
    }

    function validStudent(data, studentId) {
      return data.keys().hasOnly([
          'studentId', 'instituteId', 'studentNumber', 'fullName', 'preferredName',
          'dateOfBirth', 'gender', 'address', 'primaryParentName',
          'primaryParentMobile', 'secondaryParentName', 'secondaryParentMobile',
          'parentEmail', 'emergencyContactName', 'emergencyContactMobile',
          'status', 'active', 'qrTokenHash', 'qrVersion', 'qrEnabled',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.studentId == studentId && data.instituteId is string
        && validStudentNumber(data.studentNumber)
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 180
        && (data.preferredName == null || data.preferredName is string)
        && (data.dateOfBirth == null || data.dateOfBirth is timestamp)
        && (data.gender == null || data.gender in ['female', 'male', 'other', 'preferNotToSay'])
        && data.address is string && data.address.size() <= 500
        && data.primaryParentName is string && data.primaryParentName.size() > 0
        && data.primaryParentMobile is string && data.primaryParentMobile.matches('^\\+[1-9][0-9]{7,14}$')
        && (data.secondaryParentName == null || data.secondaryParentName is string)
        && (data.secondaryParentMobile == null || data.secondaryParentMobile.matches('^\\+[1-9][0-9]{7,14}$'))
        && (data.parentEmail == null || data.parentEmail is string)
        && (data.emergencyContactName == null || data.emergencyContactName is string)
        && (data.emergencyContactMobile == null || data.emergencyContactMobile.matches('^\\+[1-9][0-9]{7,14}$'))
        && data.status in ['active', 'inactive', 'suspended', 'leftInstitute']
        && data.active is bool && data.active == (data.status == 'active')
        && data.qrTokenHash is string && data.qrTokenHash.size() == 64
        && data.qrVersion is int && data.qrVersion > 0 && data.qrEnabled is bool
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt is timestamp && data.updatedBy is string;
    }

    function validAcademicAudit(data) {
      return data.action in [
          'classCreated', 'classUpdated', 'classActivated', 'classDeactivated',
          'classArchived', 'classTeacherAssigned', 'classTeacherRemoved',
          'classScheduleChanged', 'classScheduleChangeCancelled',
          'studentCreated', 'studentUpdated', 'studentActivated',
          'studentDeactivated', 'studentSuspended', 'studentMarkedLeft',
          'studentAssignedToClass', 'studentRemovedFromClass',
          'studentScheduleOverlapConfirmed'
        ]
        && data.targetType in ['academicClass', 'student', 'classStudentAssignment', 'scheduleChange']
        && data.actorRole in ['superAdmin', 'instituteAdmin', 'teacher']
        && data.instituteId is string
        && (
          hasVerifiedSuperAdminClaim()
          || (isActiveInstituteAdmin() && data.instituteId == callerProfile().instituteId)
          || (isActiveTeacher() && data.instituteId == callerProfile().instituteId)
        );
    }

    match /users/{uid} {
      allow get, list: if isSelf(uid)
        || hasVerifiedSuperAdminClaim()
        || mayInstituteAdminRead(resource.data);
      allow create, delete: if false;
      allow update: if (isSelf(uid) && safeSelfUpdate())
        || validTeacherManagementUpdate(uid);
    }

    match /institutes/{instituteId} {
      allow get: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin()
          && callerProfile().instituteId == instituteId);
      allow list: if hasVerifiedSuperAdminClaim();
      allow create: if hasVerifiedSuperAdminClaim()
        && validInstitute(request.resource.data, instituteId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.smsUsedThisMonth == 0
        && existsAfter(/databases/$(database)/documents/institute_codes/$(request.resource.data.instituteCode))
        && getAfter(/databases/$(database)/documents/institute_codes/$(request.resource.data.instituteCode)).data.instituteId == instituteId;
      allow update: if hasVerifiedSuperAdminClaim()
        && validInstitute(request.resource.data, instituteId)
        && request.resource.data.instituteCode == resource.data.instituteCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.smsUsedThisMonth == resource.data.smsUsedThisMonth
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /institute_codes/{code} {
      allow get: if hasVerifiedSuperAdminClaim();
      allow create: if hasVerifiedSuperAdminClaim()
        && validInstituteCode(code)
        && request.resource.data.keys().hasOnly(['instituteId', 'createdAt', 'createdBy'])
        && request.resource.data.instituteId is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete, list: if false;
    }

    match /audit_logs/{auditLogId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin()
          && resource.data.instituteId == callerProfile().instituteId)
        || (isActiveTeacher()
          && resource.data.actorUid == request.auth.uid
          && resource.data.instituteId == callerProfile().instituteId);
      allow create: if validAudit(request.resource.data, auditLogId)
        && (
          (hasVerifiedSuperAdminClaim()
            && !isTrustedAttendanceAudit(request.resource.data.action)
            && validSuperAdminAudit(request.resource.data))
          || validInstituteAdminPasswordResetAudit(request.resource.data)
          || validTeacherManagementAudit(request.resource.data)
          || validTeacherFirstLoginAudit(request.resource.data)
          || validAcademicAudit(request.resource.data)
        );
      allow update, delete: if false;
    }

    match /teacher_employee_numbers/{reservationId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin()
          && resource.data.instituteId == callerProfile().instituteId);
      allow create: if request.resource.data.keys().hasOnly([
          'instituteId', 'employeeNumber', 'teacherUid', 'createdAt', 'createdBy'
        ])
        && request.resource.data.instituteId is string
        && request.resource.data.employeeNumber is string
        && request.resource.data.employeeNumber.matches('^[A-Z0-9][A-Z0-9_-]{1,31}$')
        && reservationId == request.resource.data.instituteId + '_' + request.resource.data.employeeNumber
        && request.resource.data.teacherUid is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && (hasVerifiedSuperAdminClaim()
          || (isActiveInstituteAdmin()
            && request.resource.data.instituteId == callerProfile().instituteId))
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.teacherUid)).data.role == 'teacher'
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.teacherUid)).data.instituteId == request.resource.data.instituteId
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.teacherUid)).data.employeeNumber == request.resource.data.employeeNumber;
      allow update: if false;
      allow delete: if (hasVerifiedSuperAdminClaim()
          || (isActiveInstituteAdmin()
            && resource.data.instituteId == callerProfile().instituteId))
        && getAfter(/databases/$(database)/documents/users/$(resource.data.teacherUid)).data.employeeNumber != resource.data.employeeNumber;
    }

    match /sms_settings/{instituteId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin()
          && callerProfile().instituteId == instituteId);
      allow create, update: if hasVerifiedSuperAdminClaim()
        && validSmsSettings(request.resource.data, instituteId);
      allow delete: if false;
    }

    match /sms_usage/{instituteId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin()
          && callerProfile().instituteId == instituteId);
      allow write: if false;
    }

    match /student_sms_consents/{studentId} {
      allow get: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin() && resource.data.instituteId == callerProfile().instituteId)
        || hasActiveParentLink(studentId, resource.data.instituteId);
      allow list: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin() && resource.data.instituteId == callerProfile().instituteId);
      allow create: if validStudentSmsConsent(request.resource.data, studentId)
        && hasActiveParentLink(studentId, request.resource.data.instituteId);
      allow update: if validStudentSmsConsent(request.resource.data, studentId)
        && request.resource.data.instituteId == resource.data.instituteId
        && hasActiveParentLink(studentId, resource.data.instituteId);
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin() && resource.data.instituteId == callerProfile().instituteId)
        || (isActiveTeacher() && request.auth.uid in resource.data.teacherIds);
      allow create: if validClass(request.resource.data, classId)
        && (mayManageInstitute(request.resource.data.instituteId)
          || validTeacherClassCreate(request.resource.data))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/class_codes/$(request.resource.data.instituteId + '_' + request.resource.data.classCode))
        && getAfter(/databases/$(database)/documents/class_codes/$(request.resource.data.instituteId + '_' + request.resource.data.classCode)).data.classId == classId;
      allow update: if validClass(request.resource.data, classId)
        && (mayManageInstitute(resource.data.instituteId)
          || validTeacherClassUpdate())
        && request.resource.data.instituteId == resource.data.instituteId
        && request.resource.data.classCode == resource.data.classCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /class_codes/{reservationId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin() && resource.data.instituteId == callerProfile().instituteId);
      allow create: if request.resource.data.keys().hasOnly(['instituteId', 'classCode', 'classId', 'createdAt', 'createdBy'])
        && reservationId == request.resource.data.instituteId + '_' + request.resource.data.classCode
        && validClassCode(request.resource.data.classCode)
        && mayCreateClass(request.resource.data.instituteId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.classCode == request.resource.data.classCode;
      allow update, delete: if false;
    }

    match /class_schedule_changes/{changeId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin() && resource.data.instituteId == callerProfile().instituteId)
        || isAssignedTeacher(resource.data.classId);
      allow create: if request.resource.data.keys().hasOnly([
          'scheduleChangeId', 'instituteId', 'classId', 'effectiveDate',
          'oldStartTime', 'oldEndTime', 'newStartTime', 'newEndTime',
          'oldRoomOrLocation', 'newRoomOrLocation', 'reason', 'status',
          'changedBy', 'changedAt', 'updatedAt'
        ])
        && request.resource.data.scheduleChangeId == changeId
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && request.resource.data.status == 'scheduled'
        && request.resource.data.changedBy == request.auth.uid
        && request.resource.data.changedAt == request.time
        && request.resource.data.updatedAt == request.time
        && mayManageScheduleChange(
          request.resource.data.classId,
          request.resource.data.instituteId
        );
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time
        && mayManageScheduleChange(resource.data.classId, resource.data.instituteId);
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin() && resource.data.instituteId == callerProfile().instituteId);
      allow create: if validStudent(request.resource.data, studentId)
        && mayManageInstitute(request.resource.data.instituteId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/student_numbers/$(request.resource.data.instituteId + '_' + request.resource.data.studentNumber))
        && getAfter(/databases/$(database)/documents/student_numbers/$(request.resource.data.instituteId + '_' + request.resource.data.studentNumber)).data.studentId == studentId;
      allow update: if validStudent(request.resource.data, studentId)
        && mayManageInstitute(resource.data.instituteId)
        && request.resource.data.instituteId == resource.data.instituteId
        && request.resource.data.studentNumber == resource.data.studentNumber
        && request.resource.data.qrTokenHash == resource.data.qrTokenHash
        && request.resource.data.qrVersion == resource.data.qrVersion
        && request.resource.data.qrEnabled == resource.data.qrEnabled
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /student_numbers/{reservationId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin() && resource.data.instituteId == callerProfile().instituteId);
      allow create: if request.resource.data.keys().hasOnly(['instituteId', 'studentNumber', 'studentId', 'createdAt', 'createdBy'])
        && reservationId == request.resource.data.instituteId + '_' + request.resource.data.studentNumber
        && validStudentNumber(request.resource.data.studentNumber)
        && mayManageInstitute(request.resource.data.instituteId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.studentNumber == request.resource.data.studentNumber;
      allow update, delete: if false;
    }

    match /class_students/{assignmentId} {
      allow read: if hasVerifiedSuperAdminClaim()
        || (isActiveInstituteAdmin() && resource.data.instituteId == callerProfile().instituteId)
        || isAssignedTeacher(resource.data.classId);
      allow create, update: if request.resource.data.keys().hasOnly([
          'assignmentId', 'instituteId', 'classId', 'studentId', 'active',
          'joinedAt', 'joinedBy', 'leftAt', 'leftBy', 'status',
          'scheduleOverlapConfirmed', 'scheduleOverlapReason',
          'scheduleOverlapConfirmedBy', 'scheduleOverlapConfirmedAt'
        ])
        && request.resource.data.assignmentId == assignmentId
        && assignmentId == request.resource.data.classId + '_' + request.resource.data.studentId
        && request.resource.data.instituteId == get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.instituteId
        && request.resource.data.instituteId == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.instituteId
        && mayManageInstitute(request.resource.data.instituteId)
        && request.resource.data.status in ['active', 'inactive', 'completed', 'removed']
        && request.resource.data.active == (request.resource.data.status == 'active')
        && request.resource.data.joinedAt is timestamp && request.resource.data.joinedBy is string
        && request.resource.data.scheduleOverlapConfirmed is bool
        && (!request.resource.data.scheduleOverlapConfirmed
          || (request.resource.data.scheduleOverlapReason is string
            && request.resource.data.scheduleOverlapReason.size() > 0
            && request.resource.data.scheduleOverlapConfirmedBy == request.auth.uid
            && request.resource.data.scheduleOverlapConfirmedAt == request.time));
      allow delete: if false;
    }

    // Phase 6 trusted boundary: raw QR lookup, session writes, attendance
    // transactions, correction history, and trusted timestamps are backend-only.
    match /qr_tokens/{tokenHash} {
      allow read, write: if false;
    }

    match /attendance_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /attendance_records/{recordId} {
      allow read, write: if false;
    }

    match /attendance_corrections/{correctionId} {
      allow read, write: if false;
    }

    // Phase 7 parent-facing projections. These are written only by a future
    // trusted backend; parents never read full students or institute records.
    match /parent_student_links/{linkId} {
      allow get, list: if isActiveParent()
        && resource.data.parentUid == request.auth.uid
        && resource.data.active == true
        && instituteIsActive(resource.data.instituteId)
        && exists(/databases/$(database)/documents/parent_student_profiles/$(resource.data.studentId))
        && get(/databases/$(database)/documents/parent_student_profiles/$(resource.data.studentId)).data.instituteId
          == resource.data.instituteId
        && linkId == request.auth.uid + '_' + resource.data.studentId;
      allow create, update, delete: if false;
    }

    match /parent_student_profiles/{studentId} {
      allow get: if parentCanReadStudent(studentId, resource.data.instituteId);
      allow list, create, update, delete: if false;
    }

    match /parent_access_scopes/{parentUid} {
      allow read, write: if false;
    }

    // Callable-only operational state. These documents contain hashed actor
    // identifiers and safe metadata, but no mobile client may access them.
    match /backend_rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /backend_idempotency/{documentId} {
      allow read, write: if false;
    }

    match /backend_callable_audits/{documentId} {
      allow read, write: if false;
    }

    match /parent_class_profiles/{classId} {
      allow get: if parentCanReadClass(classId, resource.data.instituteId)
        && resource.data.active == true;
      allow list, create, update, delete: if false;
    }

    match /parent_attendance_summaries/{summaryId} {
      allow get, list: if parentCanReadStudent(
        resource.data.studentId,
        resource.data.instituteId
      );
      allow create, update, delete: if false;
    }

    match /parent_notices/{noticeId} {
      allow get, list: if parentCanReadNotice(resource.data);
      allow create, update, delete: if false;
    }

    match /institute_public_profiles/{instituteId} {
      allow get: if parentCanReadInstitute(instituteId)
        && resource.data.instituteId == instituteId;
      allow list, create, update, delete: if false;
    }

    // Device registration is callable-only so protected FCM tokens are never
    // exposed by client Firestore access.
    match /notification_devices/{uid}/tokens/{tokenId} {
      allow read, write: if false;
    }
    match /notification_preferences/{uid} {
      allow read, write: if false;
    }

    // Multi-institute membership is callable-only. A visible join code is an
    // identifier, never a client-readable credential or an access grant.
    match /institute_join_codes/{code} { allow read, write: if false; }
    match /institute_memberships/{membershipId} { allow read, write: if false; }
    match /institute_join_requests/{requestId} { allow read, write: if false; }

    // SMS queues contain protected phone/provider metadata and are backend-only.
    match /sms_outbox/{messageId} { allow read, write: if false; }
    match /sms_deliveries/{deliveryId} { allow read, write: if false; }
    match /sms_rate_limits/{key} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
